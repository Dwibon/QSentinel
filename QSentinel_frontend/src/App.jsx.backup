import { useEffect, useMemo, useState } from "react";
import {
  BarChart,
  Bar,
  CartesianGrid,
  Cell,
  ResponsiveContainer,
  Tooltip,
  XAxis,
  YAxis
} from "recharts";
import { getEvents, health, replay, simulate, unauthorized } from "./api";

const attacks = [
  ["none", "Honest Transmission"],
  ["X", "X-Pauli Attack"],
  ["Y", "Y-Pauli Attack"],
  ["Z", "Z-Pauli Attack"],
  ["intercept_resend", "Intercept-Resend"],
  ["z_measure_resend", "Z-Measure / Resend"]
];

const attackNames = Object.fromEntries(attacks);

function formatP(value) {
  if (value === undefined || value === null) return "—";
  if (value === 0) return "0";
  if (value < 0.001) return value.toExponential(2);
  return value.toFixed(3);
}

function decisionLabel(decision) {
  return {
    VALID: "VALID",
    REJECT: "THREAT DETECTED",
    REPLAY: "REPLAY DETECTED",
    UNAUTHORIZED: "UNAUTHORIZED",
    INCONCLUSIVE: "INCONCLUSIVE",
    PROTOCOL_ANOMALY: "PROTOCOL ANOMALY"
  }[decision] || decision || "WAITING";
}

function decisionClass(decision) {
  if (decision === "VALID") return "valid";
  if (decision === "REJECT") return "danger";
  if (decision === "REPLAY" || decision === "UNAUTHORIZED") return "warning";
  return "neutral";
}

function App() {
  const [attack, setAttack] = useState("none");
  const [noise, setNoise] = useState(0.03);
  const [sentinelFraction, setSentinelFraction] = useState(0.2);
  const [strength, setStrength] = useState(1);
  const [result, setResult] = useState(null);
  const [events, setEvents] = useState([]);
  const [online, setOnline] = useState(false);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  const refreshEvents = async () => {
    try {
      const data = await getEvents();
      setEvents(data.events || []);
    } catch {
      // Keep the dashboard usable if the log endpoint is temporarily unavailable.
    }
  };

  useEffect(() => {
    health()
      .then(() => setOnline(true))
      .catch(() => setOnline(false));
    refreshEvents();
    const timer = setInterval(refreshEvents, 5000);
    return () => clearInterval(timer);
  }, []);

  const runSimulation = async (selectedAttack = attack) => {
    setLoading(true);
    setError("");
    try {
      const data = await simulate(selectedAttack, {
        noise_p: Number(noise),
        sentinel_fraction: Number(sentinelFraction),
        attack_strength: Number(strength)
      });
      setResult(data);
      await refreshEvents();
    } catch (err) {
      setError(err.message);
    } finally {
      setLoading(false);
    }
  };

  const runReplay = async () => {
    setLoading(true);
    setError("");
    try {
      const data = await replay();
      setResult({
        result: data.replay_verification,
        replay: data
      });
      await refreshEvents();
    } catch (err) {
      setError(err.message);
    } finally {
      setLoading(false);
    }
  };

  const runUnauthorized = async () => {
    setLoading(true);
    setError("");
    try {
      const data = await unauthorized();
      setResult({ result: data });
      await refreshEvents();
    } catch (err) {
      setError(err.message);
    } finally {
      setLoading(false);
    }
  };

  const r = result?.result;
  const fingerprint = r?.fingerprint || { X: 0, Y: 0, Z: 0 };

  const chartData = useMemo(
    () => ["X", "Y", "Z"].map((axis) => ({
      axis,
      value: Number(fingerprint[axis] || 0)
    })),
    [fingerprint]
  );

  return (
    <div className="app-shell">
      <div className="ambient ambient-one" />
      <div className="ambient ambient-two" />

      <header className="topbar">
        <div className="brand">
          <div className="brand-mark">Q</div>
          <div>
            <div className="brand-name">QSentinel</div>
            <div className="brand-subtitle">Quantum Threat Detection</div>
          </div>
        </div>
        <div className="system-pill">
          <span className={`status-dot ${online ? "online" : ""}`} />
          {online ? "SYSTEM ONLINE" : "BACKEND OFFLINE"}
        </div>
      </header>

      <main className="dashboard">
        <section className="hero">
          <div>
            <div className="eyebrow">QUANTUM DIGITAL SIGNATURE SECURITY</div>
            <h1>Detect threats through<br /><span>quantum fingerprints.</span></h1>
            <p>
              Statistical, non-ML detection using secret Pauli-axis sentinels,
              calibrated noise baselines and protocol-level security checks.
            </p>
          </div>
          <div className="hero-orbit">
            <div className="orbit orbit-a" />
            <div className="orbit orbit-b" />
            <div className="core">Q</div>
          </div>
        </section>

        <div className="main-grid">
          <section className="panel simulator">
            <div className="panel-head">
              <div>
                <div className="panel-kicker">THREAT SIMULATOR</div>
                <h2>Attack configuration</h2>
              </div>
              <span className="live-tag">LIVE</span>
            </div>

            <label className="field-label">Attack scenario</label>
            <select value={attack} onChange={(e) => setAttack(e.target.value)}>
              {attacks.map(([value, label]) => (
                <option key={value} value={value}>{label}</option>
              ))}
            </select>

            <div className="slider-row">
              <div className="slider-title">
                <span>Attack strength</span>
                <strong>{Math.round(strength * 100)}%</strong>
              </div>
              <input
                type="range"
                min="0"
                max="1"
                step="0.01"
                value={strength}
                onChange={(e) => setStrength(Number(e.target.value))}
              />
            </div>

            <div className="slider-row">
              <div className="slider-title">
                <span>Channel noise</span>
                <strong>{Math.round(noise * 100)}%</strong>
              </div>
              <input
                type="range"
                min="0"
                max="0.2"
                step="0.01"
                value={noise}
                onChange={(e) => setNoise(Number(e.target.value))}
              />
            </div>

            <div className="slider-row">
              <div className="slider-title">
                <span>Sentinel fraction</span>
                <strong>{Math.round(sentinelFraction * 100)}%</strong>
              </div>
              <input
                type="range"
                min="0.05"
                max="0.4"
                step="0.05"
                value={sentinelFraction}
                onChange={(e) => setSentinelFraction(Number(e.target.value))}
              />
            </div>

            <button
              className="primary-button"
              onClick={() => runSimulation()}
              disabled={loading || !online}
            >
              {loading ? "RUNNING SIMULATION..." : "RUN SIMULATION  →"}
            </button>

            <div className="quick-actions">
              <button onClick={() => { setAttack("none"); runSimulation("none"); }}>Honest</button>
              <button onClick={() => { setAttack("X"); runSimulation("X"); }}>X-Pauli</button>
              <button onClick={() => { setAttack("intercept_resend"); runSimulation("intercept_resend"); }}>Intercept</button>
              <button onClick={runReplay}>Replay</button>
              <button onClick={runUnauthorized}>Unauthorized</button>
            </div>
          </section>

          <section className={`panel verdict ${decisionClass(r?.final_decision)}`}>
            <div className="panel-kicker">VERIFICATION RESULT</div>
            <div className="verdict-icon">
              {r?.final_decision === "VALID" ? "✓" :
               r?.final_decision === "REPLAY" ? "↻" :
               r?.final_decision === "UNAUTHORIZED" ? "!" :
               r?.final_decision === "REJECT" ? "×" : "·"}
            </div>
            <div className="verdict-label">
              {decisionLabel(r?.final_decision)}
            </div>
            <div className="verdict-attack">
              {r ? (attackNames[r.attack] || r.attack || "Protocol event") : "Run a simulation to begin"}
            </div>
            <div className="verdict-meta">
              <div>
                <span>QUANTUM</span>
                <strong>{r?.quantum_decision || "—"}</strong>
              </div>
              <div>
                <span>PROTOCOL</span>
                <strong>{r?.protocol_decision || "—"}</strong>
              </div>
            </div>
          </section>
        </div>

        {error && <div className="error-banner">⚠ {error}</div>}

        <section className="panel fingerprint-panel">
          <div className="section-heading">
            <div>
              <div className="panel-kicker">QUANTUM EVIDENCE</div>
              <h2>Pauli-axis fingerprint</h2>
            </div>
            <div className="formula">e<sub>a</sub> = error rate on axis a</div>
          </div>

          <div className="fingerprint-layout">
            <div className="chart-wrap">
              <ResponsiveContainer width="100%" height={280}>
                <BarChart data={chartData} margin={{ top: 20, right: 20, left: 0, bottom: 0 }}>
                  <CartesianGrid strokeDasharray="3 3" stroke="#1b2536" vertical={false} />
                  <XAxis dataKey="axis" stroke="#738198" tick={{ fill: "#9aa7bb", fontSize: 13 }} />
                  <YAxis domain={[0, 1]} stroke="#738198" tick={{ fill: "#9aa7bb", fontSize: 12 }} />
                  <Tooltip
                    contentStyle={{
                      background: "#101725",
                      border: "1px solid #26344b",
                      borderRadius: "10px",
                      color: "#fff"
                    }}
                    formatter={(value) => [Number(value).toFixed(3), "Error rate"]}
                  />
                  <Bar dataKey="value" radius={[7, 7, 0, 0]} maxBarSize={90}>
                    {chartData.map((entry) => (
                      <Cell
                        key={entry.axis}
                        fill={entry.value > 0.7 ? "#ff5c70" : entry.value > 0.15 ? "#ffb84d" : "#35d39a"}
                      />
                    ))}
                  </Bar>
                </BarChart>
              </ResponsiveContainer>
            </div>

            <div className="fingerprint-cards">
              {["X", "Y", "Z"].map((axis) => (
                <div className="axis-card" key={axis}>
                  <div className="axis-name">{axis}</div>
                  <div className="axis-value">{Number(fingerprint[axis] || 0).toFixed(3)}</div>
                  <div className="axis-track">
                    <div
                      className={`axis-fill ${fingerprint[axis] > 0.7 ? "high" : fingerprint[axis] > 0.15 ? "mid" : ""}`}
                      style={{ width: `${Math.min(100, fingerprint[axis] * 100)}%` }}
                    />
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <section className="panel">
          <div className="section-heading">
            <div>
              <div className="panel-kicker">STATISTICAL EVIDENCE</div>
              <h2>Noise-calibrated hypothesis test</h2>
            </div>
            <span className="alpha-badge">α = 0.01</span>
          </div>

          <div className="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>AXIS</th>
                  <th>BASELINE</th>
                  <th>OBSERVED</th>
                  <th>P-VALUE</th>
                  <th>DECISION</th>
                </tr>
              </thead>
              <tbody>
                {["X", "Y", "Z"].map((axis) => {
                  const item = r?.axis_results?.[axis];
                  return (
                    <tr key={axis}>
                      <td className="axis-cell">{axis}</td>
                      <td>{item ? item.baseline_rate.toFixed(3) : "—"}</td>
                      <td>{item ? item.observed_rate.toFixed(3) : "—"}</td>
                      <td className="mono">{item ? formatP(item.p_value) : "—"}</td>
                      <td>
                        <span className={`table-status ${item?.reject ? "reject" : "accept"}`}>
                          {item ? (item.reject ? "REJECT" : "ACCEPT") : "—"}
                        </span>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>

        <section className="panel events-panel">
          <div className="section-heading">
            <div>
              <div className="panel-kicker">AUDIT TRAIL</div>
              <h2>Security events</h2>
            </div>
            <button className="refresh-button" onClick={refreshEvents}>↻ Refresh</button>
          </div>

          <div className="events-list">
            {events.length === 0 && <div className="empty">No security events yet.</div>}
            {events.map((event, index) => (
              <div className="event-row" key={`${event.timestamp}-${index}`}>
                <span className={`event-dot ${event.final_decision === "VALID" ? "green" : "red"}`} />
                <span className="event-type">
                  {event.event === "simulation"
                    ? (attackNames[event.attack] || event.attack || "Simulation")
                    : event.event.replaceAll("_", " ")}
                </span>
                <span className="event-time">
                  {new Date(event.timestamp * 1000).toLocaleTimeString([], {
                    hour: "2-digit",
                    minute: "2-digit",
                    second: "2-digit"
                  })}
                </span>
                <span className={`event-decision ${decisionClass(event.final_decision)}`}>
                  {decisionLabel(event.final_decision)}
                </span>
              </div>
            ))}
          </div>
        </section>
      </main>

      <footer>
        <span>QSentinel v1.0</span>
        <span>Statistical Quantum Threat Detection</span>
      </footer>
    </div>
  );
}

export default App;
