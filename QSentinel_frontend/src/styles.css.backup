@import url("https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700;800&display=swap");

:root {
  font-family: "Inter", system-ui, sans-serif;
  color: #eef4ff;
  background: #070b14;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  min-width: 320px;
  background:
    radial-gradient(circle at 50% -20%, rgba(64, 116, 255, .12), transparent 36%),
    #070b14;
}

button, input, select { font: inherit; }

button { cursor: pointer; }

.app-shell {
  min-height: 100vh;
  overflow: hidden;
  position: relative;
}

.ambient {
  position: fixed;
  width: 500px;
  height: 500px;
  border-radius: 50%;
  filter: blur(110px);
  pointer-events: none;
  opacity: .12;
}

.ambient-one { background: #2764ff; top: 10%; left: -300px; }
.ambient-two { background: #00d7a0; bottom: -300px; right: -200px; }

.topbar {
  height: 76px;
  border-bottom: 1px solid #182235;
  background: rgba(7, 11, 20, .82);
  backdrop-filter: blur(18px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 5vw;
  position: sticky;
  top: 0;
  z-index: 20;
}

.brand { display: flex; gap: 12px; align-items: center; }

.brand-mark {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border: 1px solid #315bce;
  border-radius: 11px;
  background: linear-gradient(135deg, #173b8c, #0c1730);
  box-shadow: 0 0 24px rgba(53, 113, 255, .25);
  font-weight: 800;
}

.brand-name { font-weight: 800; letter-spacing: -.4px; }
.brand-subtitle { color: #718097; font-size: 11px; margin-top: 2px; }

.system-pill {
  border: 1px solid #1d3040;
  border-radius: 999px;
  padding: 8px 13px;
  font-size: 10px;
  letter-spacing: .9px;
  color: #9eacbf;
  display: flex;
  align-items: center;
  gap: 8px;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #ff5c70;
}

.status-dot.online {
  background: #35d39a;
  box-shadow: 0 0 10px #35d39a;
}

.dashboard {
  width: min(1180px, 92vw);
  margin: auto;
  padding: 64px 0 40px;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 300px;
  margin-bottom: 38px;
}

.eyebrow, .panel-kicker {
  color: #5c8cff;
  font-family: "DM Mono", monospace;
  font-size: 10px;
  letter-spacing: 1.8px;
  font-weight: 500;
}

.hero h1 {
  font-size: clamp(42px, 6vw, 72px);
  line-height: .98;
  letter-spacing: -4px;
  margin: 15px 0 22px;
  max-width: 760px;
}

.hero h1 span {
  background: linear-gradient(100deg, #fff 10%, #69a0ff 55%, #6be0c1);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero p {
  color: #7d8aa0;
  max-width: 650px;
  line-height: 1.7;
  font-size: 15px;
}

.hero-orbit {
  width: 190px;
  height: 190px;
  position: relative;
  margin-right: 70px;
}

.orbit {
  position: absolute;
  inset: 0;
  border: 1px solid rgba(76, 128, 255, .25);
  border-radius: 50%;
  transform: rotate(30deg) scaleY(.45);
}

.orbit-b { transform: rotate(-30deg) scaleY(.45); border-color: rgba(73, 222, 190, .22); }

.core {
  position: absolute;
  inset: 65px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: radial-gradient(circle, #1e5cf5, #10234e);
  box-shadow: 0 0 55px rgba(49, 104, 255, .55);
  font-size: 30px;
  font-weight: 800;
}

.main-grid {
  display: grid;
  grid-template-columns: 1.25fr .75fr;
  gap: 18px;
}

.panel {
  border: 1px solid #1a2638;
  border-radius: 18px;
  background: linear-gradient(145deg, rgba(17, 24, 38, .92), rgba(10, 15, 26, .94));
  box-shadow: 0 20px 60px rgba(0,0,0,.16);
  padding: 25px;
  margin-bottom: 18px;
}

.panel-head, .section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 24px;
}

.panel h2 {
  font-size: 17px;
  margin: 7px 0 0;
  letter-spacing: -.3px;
}

.live-tag, .alpha-badge {
  color: #53dca8;
  background: rgba(53, 211, 154, .08);
  border: 1px solid rgba(53, 211, 154, .2);
  border-radius: 7px;
  padding: 6px 8px;
  font: 9px "DM Mono", monospace;
  letter-spacing: 1px;
}

.alpha-badge { color: #91a0b5; border-color: #26334a; background: #101725; }

.field-label {
  display: block;
  color: #8997ac;
  font-size: 11px;
  margin-bottom: 8px;
}

select {
  width: 100%;
  color: #eaf0fa;
  background: #0b111e;
  border: 1px solid #26344a;
  border-radius: 10px;
  padding: 12px;
  outline: none;
}

.slider-row { margin-top: 21px; }

.slider-title {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: #8997ac;
  margin-bottom: 9px;
}

.slider-title strong { color: #dbe6f6; font-family: "DM Mono", monospace; }

input[type="range"] {
  width: 100%;
  accent-color: #4d83ff;
}

.primary-button {
  width: 100%;
  border: 0;
  border-radius: 10px;
  margin-top: 25px;
  padding: 14px;
  background: linear-gradient(100deg, #2d66e9, #3f83ff);
  color: white;
  font-weight: 700;
  font-size: 11px;
  letter-spacing: .8px;
  box-shadow: 0 10px 28px rgba(45, 102, 233, .2);
}

.primary-button:hover { filter: brightness(1.1); }
.primary-button:disabled { opacity: .5; cursor: not-allowed; }

.quick-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 12px;
}

.quick-actions button, .refresh-button {
  border: 1px solid #24334a;
  color: #8795a9;
  background: #0c1320;
  border-radius: 8px;
  padding: 8px 10px;
  font-size: 10px;
}

.quick-actions button:hover, .refresh-button:hover {
  border-color: #3b66ad;
  color: #d9e5f6;
}

.verdict {
  min-height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: center;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.verdict::before {
  content: "";
  position: absolute;
  width: 240px;
  height: 240px;
  border-radius: 50%;
  background: rgba(53, 211, 154, .06);
  filter: blur(40px);
}

.verdict.danger::before { background: rgba(255, 77, 100, .08); }
.verdict.warning::before { background: rgba(255, 184, 77, .08); }

.verdict-icon {
  width: 74px;
  height: 74px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 39px;
  margin: 20px 0 15px;
  border: 1px solid #31584d;
  background: rgba(53, 211, 154, .08);
  color: #53dca8;
  z-index: 1;
}

.verdict.danger .verdict-icon {
  border-color: #68303c;
  background: rgba(255, 92, 112, .08);
  color: #ff6477;
}

.verdict.warning .verdict-icon {
  border-color: #6a5030;
  background: rgba(255, 184, 77, .08);
  color: #ffbe55;
}

.verdict-label {
  font-size: 25px;
  font-weight: 800;
  letter-spacing: -.7px;
  z-index: 1;
}

.verdict-attack {
  color: #75839a;
  font-size: 12px;
  margin-top: 7px;
  z-index: 1;
}

.verdict-meta {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-top: 30px;
  z-index: 1;
}

.verdict-meta div {
  border: 1px solid #202e43;
  background: rgba(7, 12, 21, .45);
  padding: 12px;
  border-radius: 9px;
}

.verdict-meta span {
  display: block;
  font: 9px "DM Mono", monospace;
  color: #68778d;
  margin-bottom: 5px;
}

.verdict-meta strong { font-size: 11px; }

.error-banner {
  border: 1px solid #713543;
  background: rgba(130, 35, 54, .15);
  color: #ff8a9a;
  border-radius: 10px;
  padding: 12px 15px;
  margin-bottom: 18px;
  font-size: 12px;
}

.fingerprint-panel { padding-bottom: 15px; }

.formula {
  color: #647389;
  font: 10px "DM Mono", monospace;
  padding-top: 8px;
}

.fingerprint-layout {
  display: grid;
  grid-template-columns: 1.5fr .7fr;
  gap: 25px;
  align-items: center;
}

.fingerprint-cards { display: grid; gap: 10px; }

.axis-card {
  padding: 13px;
  border: 1px solid #202d42;
  background: #0c1320;
  border-radius: 11px;
}

.axis-name { color: #738198; font: 10px "DM Mono", monospace; }
.axis-value { font: 23px "DM Mono", monospace; margin: 5px 0 8px; }

.axis-track {
  height: 4px;
  background: #192438;
  border-radius: 99px;
  overflow: hidden;
}

.axis-fill {
  height: 100%;
  background: #35d39a;
  border-radius: inherit;
}
.axis-fill.high { background: #ff5c70; }
.axis-fill.mid { background: #ffb84d; }

.table-wrap { overflow-x: auto; }

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 11px;
}

th {
  text-align: left;
  color: #58677c;
  font: 9px "DM Mono", monospace;
  letter-spacing: .7px;
  padding: 11px 14px;
  border-bottom: 1px solid #202c40;
}

td {
  color: #a8b4c6;
  padding: 14px;
  border-bottom: 1px solid #151f30;
}

.axis-cell { font-weight: 800; color: #eef4ff; }
.mono { font-family: "DM Mono", monospace; }

.table-status {
  font: 9px "DM Mono", monospace;
  padding: 5px 7px;
  border-radius: 6px;
}

.table-status.accept {
  color: #53dca8;
  background: rgba(53, 211, 154, .08);
}

.table-status.reject {
  color: #ff687a;
  background: rgba(255, 92, 112, .08);
}

.events-list { display: grid; }

.event-row {
  display: grid;
  grid-template-columns: 10px 1fr 100px 130px;
  align-items: center;
  gap: 12px;
  padding: 13px 4px;
  border-bottom: 1px solid #151f30;
  font-size: 11px;
}

.event-dot { width: 7px; height: 7px; border-radius: 50%; background: #ff5c70; }
.event-dot.green { background: #35d39a; }
.event-type { color: #c5d0df; text-transform: capitalize; }
.event-time { color: #58677c; font: 10px "DM Mono", monospace; }
.event-decision { text-align: right; font: 9px "DM Mono", monospace; }
.event-decision.valid { color: #53dca8; }
.event-decision.danger { color: #ff687a; }
.event-decision.warning { color: #ffbe55; }

.empty { color: #59677c; font-size: 12px; padding: 25px 5px; }

footer {
  width: min(1180px, 92vw);
  margin: auto;
  padding: 20px 0 45px;
  display: flex;
  justify-content: space-between;
  color: #47546a;
  font: 9px "DM Mono", monospace;
  text-transform: uppercase;
  letter-spacing: .8px;
}

@media (max-width: 850px) {
  .hero { min-height: auto; }
  .hero-orbit { display: none; }
  .main-grid, .fingerprint-layout { grid-template-columns: 1fr; }
  .dashboard { padding-top: 38px; }
}

@media (max-width: 600px) {
  .topbar { padding: 0 4vw; }
  .dashboard { width: 94vw; }
  .hero h1 { letter-spacing: -2px; }
  .panel { padding: 18px; }
  .event-row { grid-template-columns: 8px 1fr 85px; }
  .event-decision { grid-column: 2 / -1; text-align: left; }
  footer { width: 94vw; }
}
